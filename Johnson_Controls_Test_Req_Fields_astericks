#Johnson_Controls_Test_Req_Fields_astericks

import unittest
from selenium import webdriver
from selenium.webdriver.support.select import Select
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.common.by import By

def last_word(text):
    text_list = text.split(' ')
    return text_list[-1]

class Johnson_Controls_Tests(unittest.TestCase):                  

    def setUp(self):
        self.driver = webdriver.Chrome()                   
        self.driver.get("https://www.johnsoncontrols.com/")
        self.driver.maximize_window()
        about_us_tab = self.driver.find_element_by_xpath('//span[@galabel="About Us"]')
        about_us_tab.click()

        contact_us_fields = self.driver.find_element_by_xpath('//a[@href="/contact-us"]')    
        contact_us_fields.click()

        wait = WebDriverWait(self.driver, 1)
        wait.until(EC.frame_to_be_available_and_switch_to_it((By.ID,'contact-us-pardot')))

    def test_asterick_on_required_field(self):                                                                                       
        first_name_field = self.driver.find_element_by_xpath('//input[@placeholder="First Name *"]')
        first_name_ph = first_name_field.get_attribute("placeholder")
        self.assertEqual(last_word(first_name_ph),'*')

        last_name_field = self.driver.find_element_by_xpath('//input[@placeholder="Last Name *"]')
        last_name_ph = last_name_field.get_attribute("placeholder")
        self.assertEqual(last_word(last_name_ph),'*')

        email_field = self.driver.find_element_by_xpath('//input[@placeholder="Email *"]')
        email_ph = email_field.get_attribute("placeholder")
        self.assertEqual(last_word(email_ph),'*')

        phone_field = self.driver.find_element_by_xpath('//input[@placeholder="Phone *"]')
        phone_ph = phone_field.get_attribute("placeholder")
        self.assertEqual(last_word(phone_ph),'*')

        #purpose_class = self.driver.find_element_by_css_selector("p[class='form-field  Purpose_of_Inquiry pd-select required    ']")                     #this is likely a bad attribute value since it requires the exact number of spaces
        purpose_class = self.driver.find_element_by_css_selector('.form-field.Purpose_of_Inquiry.pd-select.required')
        select1 = Select(purpose_class.find_element_by_class_name('select'))
        purpose_option = select1.first_selected_option
        self.assertEqual(last_word(purpose_option.text),'*')

        products_serv_class = self.driver.find_element_by_css_selector("p[class='form-field  Products_Services_I_m_Interested_In pd-select required    ']")                     #OMG this worked
        select2 = Select(products_serv_class.find_element_by_class_name('select'))
        products_serv_option = select2.first_selected_option
        self.assertEqual(last_word(products_serv_option.text),'*')

        country_class = self.driver.find_element_by_css_selector("p[class='form-field  country pd-select required    ']")                     #this is likely a bad attribute value since it requires the exact number of spaces
        select3 = Select(country_class.find_element_by_class_name('select'))
        country_option = select3.first_selected_option
        self.assertEqual(last_word(country_option.text),'*')     

    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":                      
    unittest.main()
