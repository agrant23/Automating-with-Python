#Johnson_Controls_Test_Req_Fields_astericks

import unittest
from selenium import webdriver
from selenium.webdriver.support.select import Select
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.common.by import By

def last_word(text):
    text_list = text.split(' ')
    return text_list[-1]

class Johnson_Controls_Tests(unittest.TestCase):                  

    def setUp(self):
        self.driver = webdriver.Chrome()                   
        self.driver.get("https://www.johnsoncontrols.com/")
        self.driver.maximize_window()
        about_us_tab = self.driver.find_element_by_xpath('//span[@galabel="About Us"]')
        about_us_tab.click()

        contact_us_fields = self.driver.find_element_by_xpath('//a[@href="/contact-us"]')    
        contact_us_fields.click()

        wait = WebDriverWait(self.driver, 1)
        wait.until(EC.frame_to_be_available_and_switch_to_it((By.ID,'contact-us-pardot')))

    def test_asterick_on_required_field(self):                                                                                       
        first_name_field = self.driver.find_element_by_xpath('//p[contains(@class,"first_name")]/input')
        first_name_place_holder = first_name_field.get_attribute("placeholder")
        self.assertEqual(last_word(first_name_place_holder),'*')

        
        last_name_field = self.driver.find_element_by_xpath('//p[contains(@class,"last_name")]/input')
        last_name_place_holder = last_name_field.get_attribute("placeholder")
        self.assertEqual(last_word(last_name_place_holder),'*')

        email_field = self.driver.find_element_by_xpath('//p[contains(@class,"email")]/input')
        email_place_holder = email_field.get_attribute("placeholder")
        self.assertEqual(last_word(email_place_holder),'*')

        phone_field = self.driver.find_element_by_xpath('//p[contains(@class,"phone")]/input')
        phone_place_holder = phone_field.get_attribute("placeholder")
        self.assertEqual(last_word(phone_place_holder),'*')

        purpose_class = self.driver.find_element_by_xpath('//p[contains(@class,"Purpose_of_Inquiry")]')
        select1 = Select(purpose_class.find_element_by_class_name('select'))
        purpose_option = select1.first_selected_option
        self.assertEqual(last_word(purpose_option.text),'*')

        products_serv_class = self.driver.find_element_by_xpath('//p[contains(@class,"Products_Services")]')
        select2 = Select(products_serv_class.find_element_by_class_name('select'))
        products_serv_option = select2.first_selected_option
        self.assertEqual(last_word(products_serv_option.text),'*')

        country_class = self.driver.find_element_by_xpath('//p[contains(@class,"country")]')            
        select3 = Select(country_class.find_element_by_class_name('select'))
        country_option = select3.first_selected_option
        self.assertEqual(last_word(country_option.text),'*')     

    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":                      
    unittest.main()  
