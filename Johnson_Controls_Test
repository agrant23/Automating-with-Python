#Johnson_Controls_Tests

import unittest
from selenium import webdriver

def end_ph_text(ph_text):
    ph_text_list = ph_text.split(' ')
    l = len(ph_text_list)
    return ph_text_list[l-1]

def last_word_text(ph_text):                                #It's bad coding to use two types of parsing to get the last word
    word_list = ph_text.split()                             #I just want to see which is better
    return word_list[-1]

def placeholder_text(contact_link_block,int):
    info = contact_link_block[int]
    info_field = info.find_element_by_css_selector("input[type='text']")
    ph_text_name = info_field.get_attribute("placeholder")
    return ph_text_name

class Johnson_Controls_Tests(unittest.TestCase):                  

    def setUp(self):
        self.driver = webdriver.Chrome()                   
        self.driver.get("https://www.johnsoncontrols.com/")
        self.driver.maximize_window()

    def test_contact_required_fields(self):
        drop_down_tabs = self.driver.find_elements_by_class_name('nav-item-text')            
        drop_down_about_us = drop_down_tabs[3]                                          
        drop_down_about_us.click()

        contact_us_fields = self.driver.find_element_by_xpath('//a[@href="/contact-us"]')    
        contact_us_fields.click()
        self.driver.switch_to.frame('contact-us-pardot')
        contact_link_block = self.driver.find_elements_by_css_selector('.form-field')

        first_name_1 = end_ph_text(placeholder_text(contact_link_block,0))
        self.assertEqual(first_name_1,'*')
        
        last_name_2 = end_ph_text(placeholder_text(contact_link_block,1))
        self.assertEqual(last_name_2,'*')

        email_3 = end_ph_text(placeholder_text(contact_link_block,2))
        self.assertEqual(email_3,'*')

        phone_4 = end_ph_text(placeholder_text(contact_link_block,3))
        self.assertEqual(phone_4,'*')

        info_6 = contact_link_block[5]                                #Again it's bad to do this two different ways
        purpose_6 = last_word_text(info_6.get_attribute("class"))     #I ran into a problem when trying to use get_attribute("placeholder")
        self.assertEqual(purpose_6,'required')                           

        info_7 = contact_link_block[6]
        product_services_7 = last_word_text(info_7.get_attribute("class"))
        self.assertEqual(product_services_7,'required')

        info_8 = contact_link_block[7]
        country_8 = last_word_text(info_8.get_attribute("class"))
        self.assertEqual(country_8,'required')

        
    def tearDown(self):
        self.driver.quit()

if __name__ == "__main__":                      
    unittest.main()  
